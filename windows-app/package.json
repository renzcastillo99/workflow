{
  "name": "egis-hr",
  "version": "1.0.0",
  "description": "EGIS HR - employees, attendance and leave",
  "main": "main.js",
  "author": "EGIS",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync.js",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.egis.hr",
    "productName": "EGIS HR",
    "artifactName": "EGISHR-${version}-${target}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}